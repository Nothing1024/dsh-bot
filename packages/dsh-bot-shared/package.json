{
  "name": "dsh-bot-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared roster/avatar/session-binding helpers and RPC types for ui-dsh-bot and workbench-ui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./src/index.ts"
    },
    "./roster-sections": {
      "types": "./lib/roster-sections.d.ts",
      "default": "./src/roster-sections.ts"
    },
    "./avatar": {
      "types": "./lib/avatar.d.ts",
      "default": "./src/avatar.ts"
    },
    "./session-binding": {
      "types": "./lib/session-binding.d.ts",
      "default": "./src/session-binding.ts"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "types": "./lib/index.d.ts"
}

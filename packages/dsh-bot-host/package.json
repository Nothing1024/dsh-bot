{
  "name": "dsh-bot-host",
  "version": "0.1.0",
  "private": true,
  "description": "ctx.dshBot service: askBot/listSessions/createSession over sessionTool, app:dsh-bot marks, bot model override",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown",
    "test": "vitest run --config ../../vitest.config.ts packages/dsh-bot-host/tests"
  },
  "dependencies": {
    "dsh-bot-shared": "workspace:*",
    "pinyin-pro": "^3.29.3",
    "session-marks": "link:../../../../session-tool/plugin/packages/session-marks",
    "session-tool": "link:../../../../session-tool/plugin/packages/session-tool",
    "workbench-ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
